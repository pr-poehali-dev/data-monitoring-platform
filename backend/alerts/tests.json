{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "List alerts",
      "method": "GET",
      "path": "/?limit=10",
      "expectedStatus": 200,
      "bodyMatcher": "partial",
      "expectedBody": {"items": "array"}
    },
    {
      "name": "Create alert",
      "method": "POST",
      "path": "/",
      "body": {"level": "warning", "message": "Тест", "project_id": "farm"},
      "expectedStatus": 201,
      "bodyMatcher": "partial",
      "expectedBody": {"id": "number"}
    },
    {
      "name": "Schema fail wrong level",
      "method": "POST",
      "path": "/",
      "body": {"level": "critical", "message": "Тест"},
      "expectedStatus": 400
    },
    {
      "name": "Schema fail empty message",
      "method": "POST",
      "path": "/",
      "body": {"level": "info", "message": ""},
      "expectedStatus": 400
    },
    {
      "name": "Schema fail extra field",
      "method": "POST",
      "path": "/",
      "body": {"level": "info", "message": "ok", "hack": "evil"},
      "expectedStatus": 400
    }
  ]
}