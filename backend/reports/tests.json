{
  "tests": [
    {
      "name": "OPTIONS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "List reports",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "bodyMatcher": "partial",
      "expectedBody": {"items": "array"}
    },
    {
      "name": "Generate PDF",
      "method": "POST",
      "path": "/",
      "body": {"project_id": "farm", "format": "pdf", "period": "24h"},
      "expectedStatus": 201,
      "bodyMatcher": "partial",
      "expectedBody": {"url": "string"}
    },
    {
      "name": "Schema fail wrong format",
      "method": "POST",
      "path": "/",
      "body": {"project_id": "farm", "format": "docx", "period": "24h"},
      "expectedStatus": 400
    },
    {
      "name": "Schema fail wrong project",
      "method": "POST",
      "path": "/",
      "body": {"project_id": "evil", "format": "pdf", "period": "24h"},
      "expectedStatus": 400
    }
  ]
}