{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/?action=login",
      "expectedStatus": 200
    },
    {
      "name": "Login success",
      "method": "POST",
      "path": "/?action=login",
      "body": {"email": "admin@datacore.ru", "password": "demo1234"},
      "expectedStatus": 200,
      "bodyMatcher": "partial",
      "expectedBody": {"token": "string"}
    },
    {
      "name": "Login wrong password",
      "method": "POST",
      "path": "/?action=login",
      "body": {"email": "admin@datacore.ru", "password": "wrong"},
      "expectedStatus": 401
    }
  ]
}
